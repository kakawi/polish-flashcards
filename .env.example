# Copy to .env and adjust. Everything here is optional; defaults are shown.

# AnkiConnect endpoint (Anki must be running)
ANKI_URL=http://localhost:8765

# Base input folder; each mode reads its own subfolder (input/vocab, input/qa).
# Override per run with -i
INPUT_DIR=input

# Note types, per mode. They need the fields "Front" and "Back".
# "Basic" = one card, "Basic (and reversed card)" = forward + reverse
VOCAB_NOTE_TYPE="Basic (and reversed card)"
QA_NOTE_TYPE=Basic

# Languages (Google Translate codes) and the matching edge-tts voice.
# List voices with:  edge-tts --list-voices
SOURCE_LANG=pl
TARGET_LANG=ru
TTS_VOICE=pl-PL-ZofiaNeural

# Folder for audio files; existing "<text>.mp3" files here are reused
AUDIO_DIR=audio

# Comma-separated tags added to every note
TAGS=auto

# Translation provider (vocab mode only): google | mymemory | deepl
#  google   - free, no key, but Google may block your IP with a CAPTCHA
#  mymemory - free, no key; small daily quota (set an email to raise it)
#  deepl    - needs an API key (free tier available at deepl.com)
TRANSLATOR=google
MYMEMORY_EMAIL=
DEEPL_API_KEY=
DEEPL_FREE=true

# Seconds to pause between translation requests (raise if you get rate-limited)
REQUEST_DELAY=0.7

# Log level: DEBUG, INFO, WARNING (or use -v for DEBUG)
LOG_LEVEL=INFO
