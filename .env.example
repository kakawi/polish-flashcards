# Copy to .env and adjust. Everything here is optional; defaults are shown.

# AnkiConnect endpoint (Anki must be running)
ANKI_URL=http://localhost:8765

# Folder with the deck files (one .json per deck). Override per run with -i
INPUT_DIR=input

# Audio files, stored as <deck>/<id>_front.mp3 and <id>_back.mp3;
# existing files are used as they are
AUDIO_DIR=audio

# draft: translations come from MyMemory (free, no key). It has a small daily
# quota; an email address raises it
MYMEMORY_EMAIL=

# Seconds to pause between translation requests (raise if you get rate-limited)
REQUEST_DELAY=0.7

# Log level: DEBUG, INFO, WARNING (or use -v for DEBUG)
LOG_LEVEL=INFO
